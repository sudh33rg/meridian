{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build server",
      "type": "shell",
      "command": "cargo build --package meridian-api",
      "options": {
        "cwd": "${workspaceFolder}/apps/server"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "npm: dev web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://.*"
        }
      }
    },
    {
      "label": "docker: up (database)",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
