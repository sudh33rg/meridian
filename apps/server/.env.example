DATABASE_URL=postgres://meridian:meridian_local_only@localhost:5432/meridian
BIND_ADDRESS=127.0.0.1:8080
CORS_ORIGIN=http://localhost:5173
RUST_LOG=meridian_api=info,tower_http=info

# --- Phase 1 additions (all optional in development) ---
# Base URL used in emailed links (the web app).
PUBLIC_URL=http://localhost:5173
# Development mail catcher (docker compose -f infra/docker-compose.yml up -d mailpit; inbox at :8025).
# With no SMTP_URL, emails are written to the API log instead of being sent.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Meridian <no-reply@meridian.local>
# 32+ characters. REQUIRED when APP_ENV=production; otherwise a random per-process secret is used.
# APP_SECRET=
# APP_ENV=production   # forces Secure cookies and refuses to run without APP_SECRET / SMTP
# COOKIE_SECURE=true   # set behind HTTPS
# TRUST_PROXY=true     # only behind a proxy that sets X-Forwarded-For
# SESSION_TTL_HOURS=8
# REFRESH_TTL_DAYS=30
# RATE_LIMIT_AUTH_PER_MIN=30
# RATE_LIMIT_GLOBAL_PER_MIN=1200
# METRICS_ADDR=127.0.0.1:9090   # Prometheus scrape address, or "off"
# LOG_FORMAT=json

# --- Enterprise features ---
# Object storage for attachments. Without S3_BUCKET files go to ATTACHMENTS_DIR on local disk.
# S3_BUCKET=meridian
# S3_ENDPOINT=http://localhost:9000       # MinIO / any S3-compatible service
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ATTACHMENTS_DIR=./data/attachments
# MAX_ATTACHMENT_MB=25
# CLAMAV_ADDR=localhost:3310              # scan uploads with clamd
# ATTACHMENTS_REQUIRE_SCAN=true           # only serve files that scanned clean (default on in production)
# Webhooks / SSO discovery may only reach PUBLIC https addresses. For local testing against services
# on localhost (development only, ignored when APP_ENV=production):
# ALLOW_PRIVATE_OUTBOUND=true
# WEBHOOK_RATE_PER_MIN=600
# Billing (optional). Without these, development builds expose a direct plan switch.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_BUSINESS=
